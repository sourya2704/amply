PORT=8000
DB_PATH=amply.db
SEED_DIR=seed
# Built frontend that the Go server also serves (run: cd frontend && npm run build)
STATIC_DIR=../frontend/dist
# Optional. Without it the AI assistant runs in a clearly labelled offline (rule-based) mode.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# Any long random string. Change it on a deployed server.
AUTH_SECRET=change-me
CORS_ORIGINS=*
