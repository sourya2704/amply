PORT=8000
DB_PATH=amply.db
SEED_DIR=seed
# P3's Python agent service; the Go API proxies /api/agent/* to it
AGENT_URL=http://localhost:8001
# Any long random string. Change it on the deployed server.
AUTH_SECRET=change-me
# Comma-separated list, or * for any origin (fine for the prototype)
CORS_ORIGINS=*
