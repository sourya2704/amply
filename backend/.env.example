PORT=8000
# Postgres with the PostGIS extension. Local: `docker compose up -d db` (see docker-compose.yml)
DATABASE_URL=postgres://amply:amply@localhost:5434/amply?sslmode=disable
SEED_DIR=seed
# Built frontend that the Go server also serves (run: cd frontend && npm run build)
STATIC_DIR=../frontend/dist
# Any long random string. REQUIRED in production.
AUTH_SECRET=change-me
CORS_ORIGINS=*
# Show one-click demo accounts on the login page
DEMO_MODE=true
# Road routing server (OSRM). Empty = straight-line estimates.
ROUTE_URL=https://router.project-osrm.org
# Address search for the trip planner (OpenStreetMap Nominatim). Empty = pilot areas only.
GEOCODE_URL=https://nominatim.openstreetmap.org

# Optional: AI assistant model. Without a key it runs in a labelled offline mode.
ANTHROPIC_API_KEY=
AGENT_MODEL=

# Optional: Razorpay TEST keys. Without them a labelled mock payment provider is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
